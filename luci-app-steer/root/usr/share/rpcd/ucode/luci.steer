#!/usr/bin/ucode
/* SPDX-License-Identifier: GPL-3.0-or-later */

'use strict';

import { error as fs_error, mkdtemp, open, popen, rmdir, unlink } from 'fs';

const ubus = require('ubus').connect();

function failure(code, detail, status) {
	return { ok: false, error_code: code, error: detail, status };
}

function shellquote(value) {
	if (value == null)
		value = '';

	return "'" + replace(value, "'", "'\\''") + "'";
}

function command_json(command) {
	const process = popen(command);
	if (!process)
		return failure('CONTROL_START_FAILED', 'Unable to start the Steer control program.');
	const output = process.read('all') || '';
	const status = process.close();
	let result;
	try {
		result = json(output);
	}
	catch (error) {
		return failure('CONTROL_OUTPUT_INVALID', trim(output) || `${error}`, status);
	}
	if (status !== 0) {
		result.ok = false;
		if (result.error_code == null)
			result.error_code = 'CONTROL_EXIT_FAILED';
		if (result.error == null)
			result.error = `Steer control program exited with status ${status}.`;
	}
	return result;
}

function command_json_input(input) {
	const directory = mkdtemp('/tmp/steer-import-XXXXXX');
	if (!directory)
		return failure('IMPORT_TEMP_FAILED', 'Unable to create a private import workspace.');
	const output = directory + '/result.json';
	const process = popen('/usr/sbin/steer _parse-nodes --output ' + shellquote(output), 'w');
	if (!process) {
		const reason = fs_error();
		rmdir(directory);
		return failure('IMPORT_START_FAILED', reason || 'Unable to start the Steer node parser.');
	}
	process.write(input || '');
	const status = process.close();
	if (status == 127) {
		rmdir(directory);
		return failure('IMPORT_PROGRAM_MISSING', 'The Steer node parser program could not be executed.', status);
	}
	if (status == 126) {
		rmdir(directory);
		return failure('IMPORT_PROGRAM_NOT_EXECUTABLE', 'The Steer node parser program is not executable.', status);
	}
	const file = open(output, 'r');
	const content = file ? (file.read('all') || '') : '';
	if (file)
		file.close();
	unlink(output);
	rmdir(directory);
	if (status != 0)
		return failure('IMPORT_PARSE_FAILED', 'The node share-link document could not be parsed.', status);
	try {
		return json(content);
	}
	catch (error) {
		return failure('IMPORT_OUTPUT_INVALID', trim(content) || `${error}`, status);
	}
}

function validation_failure(code, message) {
	return {
		ok: false,
		errors: [ { code, object_type: 'uci', message } ],
		warnings: []
	};
}

function session_id(request) {
	const session = request?.args?.ubus_rpc_session;
	if (type(session) != 'string' || match(session, /^[0-9a-f]{32}$/) == null)
		return null;
	return session;
}

function with_committed_configuration(request, callback) {
	const session = session_id(request);
	if (!session) {
		request.reply({ ok: false, error_code: 'PENDING_STATE_UNAVAILABLE', error: 'The LuCI UCI session is unavailable.' });
		return;
	}
	return ubus.defer('uci', 'changes', {
		config: 'steer',
		ubus_rpc_session: session
	}, function(code, reply) {
		const changes = reply?.changes;
		if (code != 0 || type(changes) != 'array') {
			request.reply({ ok: false, error_code: 'PENDING_STATE_UNAVAILABLE', error: 'Unable to inspect pending Steer changes.' });
			return;
		}
		if (length(changes) > 0) {
			request.reply({
				ok: false,
				error_code: 'PENDING_CHANGES',
				error: 'Apply or discard pending Steer changes before operating on the committed configuration.'
			});
			return;
		}
		request.reply(callback());
	});
}

function candidate_document(reply) {
	const sections = reply?.values;
	if (type(sections) != 'object' || sections == null)
		return null;

	const sectionNames = keys(sections);
	sort(sectionNames, (left, right) =>
		(sections[left]?.['.index'] || 0) - (sections[right]?.['.index'] || 0));
	const lines = [];
	for (let sectionIndex = 0; sectionIndex < length(sectionNames); sectionIndex++) {
		const sectionName = sectionNames[sectionIndex];
		const section = sections[sectionName];
		const sectionType = section?.['.type'];
		const sectionID = section?.['.name'] || sectionName;
		if (type(sectionType) != 'string' || type(sectionID) != 'string')
			return null;
		push(lines, 'config ' + shellquote(sectionType) + ' ' + shellquote(sectionID));

		const optionNames = keys(section);
		sort(optionNames);
		for (let optionIndex = 0; optionIndex < length(optionNames); optionIndex++) {
			const option = optionNames[optionIndex];
			if (substr(option, 0, 1) == '.')
				continue;
			const value = section[option];
			if (type(value) == 'array') {
				for (let itemIndex = 0; itemIndex < length(value); itemIndex++)
					push(lines, '\tlist ' + shellquote(option) + ' ' + shellquote(value[itemIndex]));
			}
			else if (value != null) {
				push(lines, '\toption ' + shellquote(option) + ' ' + shellquote(value));
			}
		}
		push(lines, '');
	}
	return join('\n', lines);
}

function with_candidate(request, callback) {
	const session = session_id(request);
	if (!session) {
		callback('The LuCI UCI session is unavailable.');
		return;
	}
	return ubus.defer('uci', 'get', {
		config: 'steer',
		ubus_rpc_session: session
	}, function(code, reply) {
		const document = code == 0 ? candidate_document(reply) : null;
		if (!document)
			callback('Unable to read the pending Steer configuration.');
		else
			callback(null, { session, document });
	});
}

function run_candidate(document, action) {
	const directory = mkdtemp('/tmp/steer-candidate-XXXXXX');
	if (!directory)
		return null;
	const path = directory + '/steer';
	const file = open(path, 'w');
	if (!file) {
		rmdir(directory);
		return null;
	}
	file.write(document);
	file.close();
	const result = command_json('/usr/sbin/steer ' + action + ' --config ' + shellquote(path));
	unlink(path);
	rmdir(directory);
	return result;
}

function validate_candidate(request, callback) {
	return with_candidate(request, function(error, candidate) {
		if (error) {
			callback(validation_failure('CANDIDATE_READ_FAILED', error), null);
			return;
		}
		const validation = run_candidate(candidate.document, 'validate');
		callback(validation?.errors ? validation : validation_failure('CANDIDATE_VALIDATE_FAILED', 'Unable to validate the pending Steer configuration.'), candidate);
	});
}

function commit_candidate(request) {
	return validate_candidate(request, function(validation, validatedCandidate) {
		if (validation?.ok !== true) {
			request.reply({ committed: false, validation });
			return;
		}
		/* rpcd exposes no revision/CAS primitive here. This re-read rejects
		 * changes already observable after validation, but it is deliberately
		 * not claimed as an atomic guard for the final commit window. */
		return with_candidate(request, function(error, currentCandidate) {
			if (error || currentCandidate.document != validatedCandidate.document) {
				request.reply({
					committed: false,
					validation: validation_failure('CANDIDATE_CHANGED', error || 'The pending Steer configuration changed during validation. Please review and retry.')
				});
				return;
			}
			return ubus.defer('uci', 'commit', {
				config: 'steer',
				ubus_rpc_session: currentCandidate.session
			}, function(code, reply) {
				request.reply({
					committed: code == 0,
					validation,
					error_code: code == 0 ? null : 'CANDIDATE_COMMIT_FAILED',
					error: code == 0 ? null : 'Unable to commit the validated Steer configuration.'
				});
			});
		});
	});
}

function discard_candidate(request) {
	const session = session_id(request);
	if (!session)
		return failure('PENDING_STATE_UNAVAILABLE', 'The LuCI UCI session is unavailable.');
	return ubus.defer('uci', 'revert', {
		config: 'steer',
		ubus_rpc_session: session
	}, function(code, reply) {
		request.reply({
			ok: code == 0,
			error_code: code == 0 ? null : 'CANDIDATE_REVERT_FAILED',
			error: code == 0 ? null : 'Unable to discard the pending Steer configuration.'
		});
	});
}

function secret_option(key) {
	return key == 'uuid' || key == 'private_key' || key == 'url' || key == 'extra_args' || key == 'plugin_options' ||
		match(key, /(^|_)(password|token)$/) != null;
}

function redact_secrets(value) {
	const valueType = type(value);
	if ((valueType != 'array' && valueType != 'object') || value == null)
		return value;

	const redacted = valueType == 'array' ? [] : {};
	for (let key in value) {
		const item = value[key];
		redacted[key] = secret_option(key) && item != null && `${item}` != ''
			? '[REDACTED]'
			: redact_secrets(item);
	}
	return redacted;
}

function preview_failure(code, message) {
	return { ok: false, source: 'unavailable', redacted: true, error_code: code, error: message };
}

function pending_preview() {
	return {
		ok: true,
		source: 'unavailable',
		pending: true,
		available: false,
		redacted: true,
		intent: null
	};
}

function recent_logs() {
	const process = popen([ '/sbin/logread', '-e', 'steer' ], 'r');
	if (!process)
		return failure('LOG_READ_FAILED', 'Unable to read Steer logs.');
	const output = process.read('all') || '';
	const status = process.close();
	if (status == 0)
		return { ok: true, output };
	const result = failure('LOG_READ_FAILED', 'Unable to read Steer logs.', status);
	result.output = output;
	return result;
}

function overview_state(request) {
	return with_candidate(request, function(error, candidate) {
		if (error) {
			request.reply(failure('LIFECYCLE_PENDING_READ_FAILED', error));
			return;
		}
		const desired = run_candidate(candidate.document, '_state --saved-only');
		const committed = command_json('/usr/sbin/steer _state');
		if (desired?.saved == null || committed?.saved == null || committed?.active == null) {
			request.reply(failure('LIFECYCLE_STATE_FAILED', 'Unable to read Steer lifecycle state.'));
			return;
		}
		return with_candidate(request, function(latestError, latest) {
			if (latestError || latest.document != candidate.document) {
				request.reply(failure('LIFECYCLE_CHANGED', latestError || 'Pending Steer changes changed while lifecycle state was read. Retry.'));
				return;
			}
			return ubus.defer('uci', 'changes', {
				config: 'steer',
				ubus_rpc_session: latest.session
			}, function(code, reply) {
				if (code != 0 || type(reply?.changes) != 'array') {
					request.reply(failure('PENDING_STATE_UNAVAILABLE', 'Unable to inspect pending Steer changes.'));
					return;
				}
				request.reply({
					ok: true,
					pending: length(reply.changes) > 0,
					pending_apply: committed.pending_apply == true,
					desired: desired.saved,
					saved: committed.saved,
					active: committed.active
				});
			});
		});
	});
}

function intent_preview(request) {
	const session = session_id(request);
	if (!session)
		return preview_failure('PENDING_STATE_UNAVAILABLE', 'The LuCI UCI session is unavailable.');

	return ubus.defer('uci', 'changes', {
		config: 'steer',
		ubus_rpc_session: session
	}, function(code, reply) {
		const changes = reply?.changes;
		if (code != 0 || type(changes) != 'array') {
			request.reply(preview_failure('PENDING_STATE_UNAVAILABLE', 'Unable to inspect the pending Steer configuration.'));
			return;
		}
		/* Never substitute the committed intent for a pending Apply input. */
		if (length(changes) > 0) {
			request.reply(pending_preview());
			return;
		}

		const intent = command_json('/usr/sbin/steer _export-intent');
		if (!intent || intent?.error != null) {
			request.reply(preview_failure('PREVIEW_DECODE_FAILED', 'Unable to decode the Steer configuration preview.'));
			return;
		}
		return ubus.defer('uci', 'changes', {
			config: 'steer',
			ubus_rpc_session: session
		}, function(code, reply) {
			const latestChanges = reply?.changes;
			if (code != 0 || type(latestChanges) != 'array') {
				request.reply(preview_failure('PENDING_STATE_UNAVAILABLE', 'Unable to inspect the pending Steer configuration.'));
				return;
			}
			if (length(latestChanges) > 0) {
				request.reply(pending_preview());
				return;
			}
			const reveal = request?.args?.reveal == true;
			request.reply({
				ok: true,
				source: 'committed',
				pending: false,
				available: true,
				redacted: !reveal,
				intent: reveal ? intent : redact_secrets(intent)
			});
		});
	});
}

const methods = {
	status: {
		call: function() {
			return command_json('/usr/sbin/steer status');
		}
	},
	overview_state: {
		call: overview_state
	},
	set_enabled: {
        args: { enabled: false },
        call: function(request) {
            return command_json('/usr/sbin/steer apply --enabled ' + (request.args.enabled === true ? 'true' : 'false'));
        }
    },
	apply_saved: {
		call: function(request) {
			return with_committed_configuration(request, function() {
				return command_json('/usr/sbin/steer apply');
			});
		}
	},
	validate: {
		call: function() {
			return command_json('/usr/sbin/steer validate');
		}
	},
	commit_candidate: {
		call: commit_candidate
	},
	discard_candidate: {
		call: discard_candidate
	},
	intent_preview: {
		args: { reveal: false },
		call: intent_preview
	},
	runtime: {
		call: function() {
			return command_json('/usr/sbin/steer _runtime');
		}
	},
	logs: {
		call: function() {
			return recent_logs();
		}
	},
	diagnostics: {
		call: function() {
			const diagnostics = command_json('/usr/sbin/steer _diagnostics');
			const logs = recent_logs();
			diagnostics.logs = logs.output || '';
			if (!logs.ok && diagnostics.error == null)
				diagnostics.log_error = logs.error;
			return diagnostics;
		}
	},
	probe_results: {
		call: function() {
			return command_json('/usr/sbin/steer _probe-results');
		}
	},
	geodata_catalog: {
		call: function() {
			const geosite = command_json('/usr/sbin/steer geo-catalog --kind geosite');
			const geoip = command_json('/usr/sbin/steer geo-catalog --kind geoip');
			return {
				geosite: geosite.names ? { ok: true, names: geosite.names } : { ok: false, names: [], error_code: geosite.error_code, error: geosite.error },
				geoip: geoip.names ? { ok: true, names: geoip.names } : { ok: false, names: [], error_code: geoip.error_code, error: geoip.error }
			};
		}
	},
	subscriptions: {
		call: function() {
			return command_json('/usr/sbin/steer subscription status');
		}
	},
	subscription_update: {
		args: { id: '' },
		call: function(request) {
			const id = request?.args?.id;
			if (!id)
				return failure('MISSING_SUBSCRIPTION_ID', 'A Subscription ID is required.');
			return with_committed_configuration(request, function() {
				return command_json('/usr/sbin/steer subscription update --id ' + shellquote(id));
			});
		}
	},
	subscription_clean: {
		args: { id: '', node: '' },
		call: function(request) {
			const id = request?.args?.id;
			const node = request?.args?.node;
			if (!id || !node)
				return failure('MISSING_SUBSCRIPTION_NODE_ID', 'A Subscription ID and Node ID are required.');
			return with_committed_configuration(request, function() {
				return command_json('/usr/sbin/steer subscription clean --id ' + shellquote(id) + ' --node ' + shellquote(node));
			});
		}
	},
	node_speedtest: {
		args: { node: '', download: false },
		call: function(request) {
			const node = request?.args?.node;
			if (!node)
				return failure('MISSING_NODE_ID', 'A Node ID is required.');
			return with_committed_configuration(request, function() {
				let command = '/usr/sbin/steer probe --kind speedtest --node ' + shellquote(node);
				if (request.args.download)
					command += ' --download';
				return command_json(command);
			});
		}
	},
	route_speedtest: {
		args: { route: '', download: false },
		call: function(request) {
			const route = request?.args?.route;
			if (!route)
				return failure('MISSING_ROUTE_ID', 'A Route ID is required.');
			return with_committed_configuration(request, function() {
				let command = '/usr/sbin/steer probe --kind speedtest --route ' + shellquote(route);
				if (request.args.download)
					command += ' --download';
				return command_json(command);
			});
		}
	},
	overview_probe: {
		args: { kind: '' },
		call: function(request) {
			const kind = request?.args?.kind;
			if (kind != 'direct' && kind != 'proxy' && kind != 'speedtest')
				return failure('INVALID_PROBE_KIND', 'Probe kind must be direct, proxy, or speedtest.');
			return command_json('/usr/sbin/steer probe --kind ' + kind);
		}
	},
	node_import: {
		args: { document: '' },
		call: function(request) {
			const document = request?.args?.document;
			if (!document)
				return failure('MISSING_NODE_DOCUMENT', 'At least one node share link is required.');
			return command_json_input(document);
		}
	},
	node_export: {
		args: { node: '' },
		call: function(request) {
			const node = request?.args?.node;
			if (!node)
				return failure('MISSING_NODE_ID', 'A Node ID is required.');
			return with_candidate(request, function(error, candidate) {
				if (error) {
					request.reply(failure('NODE_EXPORT_FAILED', error));
					return;
				}
				const result = run_candidate(candidate.document, '_export-node --id ' + shellquote(node));
				request.reply(result || failure('NODE_EXPORT_FAILED', 'Unable to export the Node share link.'));
			});
		}
	}
};

return { 'luci.steer': methods };
