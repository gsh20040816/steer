# Maintainer: Shenghan Gao <gsh20040816 at gmail dot com>

pkgname=steer
pkgver=0.10.0
pkgrel=1
_commit=64f70c7bd24ad9bd2419bb531962114d22e54ed5
pkgdesc='Transparent proxy policy compiler and Linux systemd adapter'
arch=('x86_64' 'aarch64')
url='https://github.com/gsh20040816/steer'
license=('GPL-3.0-or-later')
depends=(
  'ca-certificates'
  'iproute2'
  'nftables'
  'sing-box'
  'systemd'
)
makedepends=(
  'git'
  'go'
)
backup=(
  'etc/steer/config.json'
  'etc/steer/web.json'
)
source=(
  "$pkgname::git+$url.git#commit=$_commit"
  'steer-geodata.tar.zst::https://gsh20040816.github.io/steer/geodata/latest/steer-geodata.tar.zst'
)
noextract=('steer-geodata.tar.zst')
sha256sums=('SKIP' 'SKIP')

prepare() {
  rm -rf -- "$srcdir/geodata-seed"
  mkdir -p "$srcdir/geodata-seed"
  bsdtar -xf "$srcdir/steer-geodata.tar.zst" -C "$srcdir/geodata-seed"
  cd "$srcdir/$pkgname/go"
  go run ./cmd/steer-geodata-build verify --directory "$srcdir/geodata-seed"
}

build() {
  cd "$pkgname/go"
  CGO_ENABLED=0 go build \
    -trimpath \
    -ldflags="-s -w -X main.version=$pkgver" \
    -o steer \
    ./cmd/steer-linux
}

package() {
  cd "$pkgname"

  install -Dm755 go/steer "$pkgdir/usr/bin/steer"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -dm700 "$pkgdir/etc/steer"
  install -m600 linux/config.example.json "$pkgdir/etc/steer/config.json"
  install -m600 linux/web.example.json "$pkgdir/etc/steer/web.json"
  install -dm755 "$pkgdir/usr/share/steer"
  cp -a "$srcdir/geodata-seed" "$pkgdir/usr/share/steer/geodata-seed"
  install -Dm644 linux/systemd/steer.service \
    "$pkgdir/usr/lib/systemd/system/steer.service"
  install -Dm644 linux/systemd/steer-web.service \
    "$pkgdir/usr/lib/systemd/system/steer-web.service"
  install -Dm644 linux/systemd/steer-subscription.service \
    "$pkgdir/usr/lib/systemd/system/steer-subscription.service"
  install -Dm644 linux/systemd/steer-subscription.timer \
    "$pkgdir/usr/lib/systemd/system/steer-subscription.timer"
}
