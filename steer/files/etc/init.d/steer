#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-3.0-or-later

START=99
STOP=10
USE_PROCD=1

# The OpenWrt package framework stops the old init script before running the
# new package's post-install hook. During an upgrade, defer the automatic start
# until the package hook has validated and explicitly applied the existing
# schema 9 configuration.
[ "${PKG_UPGRADE:-0}" = 1 ] && USE_PROCD=

CONTROL=/usr/sbin/steer
SING_BOX=/usr/bin/sing-box
RUN_DIRECTORY=/run/steer

# Disable Apply must stop the sing-box instance without deleting the procd
# service object. The object owns the config.change trigger used by the next
# LuCI commit to re-enable Steer.
extra_command "stop_runtime" "Stop the Steer runtime without removing its procd triggers"

stop_runtime() {
	if ubus call service state '{"name":"steer","spawn":false}' >/dev/null 2>&1; then
		local attempt services
		for attempt in 1 2 3 4 5; do
			services="$(ubus call service list '{"name":"steer"}' 2>/dev/null)" || return 1
			if ! echo "$services" | grep -q '"running":true'; then
				return 0
			fi
			sleep 1
		done
		return 1
	fi

	# A disabled service may not have been started since boot. Treat that
	# expected absence as success, but propagate a real procd/list failure.
	local services
	services="$(ubus call service list '{"name":"steer"}' 2>/dev/null)" || return 1
	! echo "$services" | grep -q '"steer"'
}

steer_enabled() {
	config_load steer || return 2
	local count=0 enabled=0
	read_main() {
		count=$((count + 1))
		config_get_bool enabled "$1" enabled 0
	}
	config_foreach read_main steer
	[ "$count" -eq 1 ] || return 2
	[ "$enabled" -eq 1 ]
}

start_service() {
	steer_enabled
	local enabled_result=$?
	[ "$enabled_result" -eq 1 ] && return 0
	[ "$enabled_result" -eq 0 ] || return "$enabled_result"

	if [ "${STEER_USE_CURRENT:-0}" != 1 ]; then
		"$CONTROL" _start >/dev/null || return 1
	fi
	[ -s "$RUN_DIRECTORY/current/sing-box.json" ] || return 1

	procd_open_instance sing-box
	procd_set_param command "$CONTROL" _supervise --core "$SING_BOX" --config "$RUN_DIRECTORY/current/sing-box.json"
	procd_set_param file "$RUN_DIRECTORY/current/sing-box.json"
	procd_set_param respawn
	procd_set_param term_timeout 10
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_stopped() {
	[ -s "$RUN_DIRECTORY/current/platform.json" ] || return 0
	"$CONTROL" cleanup
}

reload_service() {
	"$CONTROL" apply >/dev/null
}

service_triggers() {
	procd_add_reload_trigger steer
}
