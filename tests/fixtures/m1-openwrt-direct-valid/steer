config steer 'main'
	option schema_version '10'
	option enabled '1'
	option log_level 'warn'
	option dns_cache_capacity '4096'
	option dns_cache_persist '1'
	option dns_optimistic_cache '1'
	option probe_direct 'https://openwrt.org/'
	option probe_proxy 'https://www.google.com/generate_204'
	option speedtest_proxy 'https://speed.cloudflare.com/__down?bytes=1000000'

config bootstrap 'bootstrap'
	option protocol 'udp'
	option server '1.1.1.1'
	option server_port '53'
	option strategy 'prefer_ipv4'

config route 'direct'
	option kind 'direct'

config route 'block'
	option kind 'block'

config dns_profile 'public'
	option protocol 'udp'
	option server '1.1.1.1'
	option server_port '53'

config local_proxy 'local'
	option protocol 'mixed'
	option listen '127.0.0.1'
	option listen_port '1090'

config rule 'mac_direct'
	list source_mac_address '02:00:00:00:00:10'
	option dns_profile 'public'
	option route 'direct'

config rule 'local_direct'
	list inbound 'local'
	option dns_profile 'public'
	option route 'direct'

config rule 'blocked'
	list domain_match 'domain:blocked.invalid'
	option dns_profile 'public'
	option route 'block'

config rule 'geo_cn'
	list domain_match 'geosite:cn'
	option dns_profile 'public'
	option route 'direct'

config rule 'default'
	option default '1'
	option dns_profile 'public'
	option route 'direct'
