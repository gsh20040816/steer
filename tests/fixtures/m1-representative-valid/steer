config steer 'main'
	option schema_version '10'
	option enabled '1'
	option log_level 'warn'
	option dns_cache_capacity '32768'
	option probe_direct 'https://www.baidu.com/'
	option probe_proxy 'https://www.google.com/generate_204'
	option speedtest_proxy 'https://speed.cloudflare.com/__down?bytes=1000000'

config bootstrap 'bootstrap'
	option protocol 'udp'
	option server '1.1.1.1'
	option server_port '53'
	option strategy 'prefer_ipv4'

config node 'reality_node'
	option type 'vless'
	option server 'reality.example.com'
	option server_port '443'
	option uuid '00000000-0000-4000-8000-000000000001'
	option flow 'xtls-rprx-vision'
	option packet_encoding 'xudp'
	option tls_server_name 'www.example.com'
	option reality_public_key 'bm90LWEtcmVhbC1wdWJsaWMta2V5LWZvci10ZXN0cyE'
	option reality_short_id '0123456789abcdef'
	option utls_fingerprint 'chrome'

config node 'hy2_node'
	option type 'hysteria2'
	option server 'hy2.example.com'
	option server_port '443'
	list server_ports '12000:12010'
	option hop_interval '45s'
	option password 'fixture-hysteria2-password'
	option tls_server_name 'hy2.example.com'
	option obfs_type 'salamander'
	option obfs_password 'fixture-obfs-password'
	option up_mbps '10'
	option down_mbps '20'

config node 'trojan_node'
	option type 'trojan'
	option server 'trojan.example.com'
	option server_port '443'
	option password 'fixture-trojan-password'
	option tls_server_name 'trojan.example.com'

config route 'direct'
	option kind 'direct'

config route 'block'
	option kind 'block'

config route 'reality_route'
	option kind 'single'
	option node 'reality_node'

config route 'hy2_route'
	option kind 'single'
	option node 'hy2_node'

config route 'trojan_route'
	option kind 'single'
	option node 'trojan_node'

config dns_profile 'dns_udp'
	option protocol 'udp'
	option server '192.0.2.53'
	option server_port '53'

config dns_profile 'dns_tcp'
	option protocol 'tcp'
	option server '192.0.2.54'
	option server_port '53'

config dns_profile 'dns_dot'
	option protocol 'tls'
	option server '192.0.2.55'
	option server_port '853'
	option tls_server_name 'dot.example.com'

config dns_profile 'dns_doh'
	option protocol 'https'
	option server '192.0.2.56'
	option server_port '443'
	option tls_server_name 'doh.example.com'
	option path '/dns-query'

config dns_profile 'dns_doq'
	option protocol 'quic'
	option server '192.0.2.57'
	option server_port '853'
	option tls_server_name 'doq.example.com'

config dns_profile 'dns_doh3'
	option protocol 'h3'
	option server '192.0.2.58'
	option server_port '443'
	option tls_server_name 'doh3.example.com'
	option path '/dns-query'

config local_proxy 'developer_proxy'
	option protocol 'mixed'
	option listen '127.0.0.1'
	option listen_port '1090'

config rule 'mac_direct'
	list source_mac_address '02:00:00:00:00:10'
	option dns_profile 'dns_udp'
	option route 'direct'

config rule 'tcp_dns'
	list domain_match 'domain:tcp.example'
	option dns_profile 'dns_tcp'
	option route 'direct'

config rule 'dot_dns'
	list domain_match 'domain:dot.example'
	option dns_profile 'dns_dot'
	option route 'reality_route'

config rule 'doh_dns'
	list domain_match 'domain:doh.example'
	list domain_match 'geosite:category-example'
	option dns_profile 'dns_doh'
	option route 'reality_route'

config rule 'doq_dns'
	list domain_match 'domain:doq.example'
	list protocol 'quic'
	option dns_profile 'dns_doq'
	option route 'hy2_route'

config rule 'doh3_dns'
	list domain_match 'domain:doh3.example'
	list ip_match 'geoip:example'
	option dns_profile 'dns_doh3'
	option route 'trojan_route'

config rule 'local_proxy_rule'
	list inbound 'developer_proxy'
	option dns_profile 'dns_doh'
	option route 'reality_route'

config rule 'blocked'
	list domain_match 'domain:blocked.example'
	option dns_profile 'dns_udp'
	option route 'block'

config rule 'default'
	option default '1'
	option dns_profile 'dns_doh'
	option route 'reality_route'
