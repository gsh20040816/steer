config steer 'main'
	option schema_version '10'
	option enabled '1'
	option log_level 'warn'
	option dns_cache_capacity '4096'
	option probe_direct 'https://www.baidu.com/'
	option probe_proxy 'https://www.google.com/generate_204'
	option speedtest_proxy 'https://speed.cloudflare.com/__down?bytes=1000000'

config bootstrap 'bootstrap'
	option protocol 'udp'
	option server '1.1.1.1'
	option server_port '53'
	option strategy 'prefer_ipv4'

config node 'front_node'
	option type 'socks'
	option server '192.0.2.10'
	option server_port '1080'

config node 'exit_node'
	option type 'socks'
	option server '192.0.2.11'
	option server_port '1080'

config route 'direct'
	option kind 'direct'

config route 'front'
	option kind 'single'
	option node 'front_node'

config route 'exit'
	option kind 'single'
	option node 'exit_node'
	option detour 'front'

config dns_profile 'public'
	option protocol 'udp'
	option server '1.1.1.1'
	option server_port '53'

config rule 'default'
	option default '1'
	option dns_profile 'public'
	option route 'exit'
