{
  "schema_version": 1,
  "collections": [
    "wireguard_tunnels",
    "nodes",
    "routes",
    "dns_profiles",
    "local_proxies",
    "rules",
    "subscriptions"
  ],
  "cases": [
    {
      "name": "manual nodes move by stable ID",
      "collection": "nodes",
      "objects": [
        { "id": "manual_a" },
        { "id": "manual_b" },
        { "id": "manual_c" }
      ],
      "visible_ids": ["manual_a", "manual_b", "manual_c"],
      "move_id": "manual_c",
      "offset": -1,
      "expected_ids": ["manual_a", "manual_c", "manual_b"]
    },
    {
      "name": "system routes remain outside the movable peer list",
      "collection": "routes",
      "objects": [
        { "id": "direct", "kind": "direct" },
        { "id": "single_a", "kind": "single" },
        { "id": "block", "kind": "block" },
        { "id": "single_b", "kind": "single" }
      ],
      "visible_ids": ["single_a", "single_b"],
      "move_id": "single_b",
      "offset": -1,
      "expected_ids": ["direct", "single_b", "single_a", "block"]
    },
    {
      "name": "dns profiles use stable IDs",
      "collection": "dns_profiles",
      "objects": [{ "id": "dns_a" }, { "id": "dns_b" }],
      "visible_ids": ["dns_a", "dns_b"],
      "move_id": "dns_b",
      "offset": -1,
      "expected_ids": ["dns_b", "dns_a"]
    },
    {
      "name": "local proxies use stable IDs",
      "collection": "local_proxies",
      "objects": [{ "id": "proxy_a" }, { "id": "proxy_b" }],
      "visible_ids": ["proxy_a", "proxy_b"],
      "move_id": "proxy_b",
      "offset": -1,
      "expected_ids": ["proxy_b", "proxy_a"]
    },
    {
      "name": "default rule remains pinned last",
      "collection": "rules",
      "objects": [
        { "id": "rule_a", "default": false },
        { "id": "rule_b", "default": false },
        { "id": "default", "default": true }
      ],
      "visible_ids": ["rule_a", "rule_b"],
      "move_id": "rule_b",
      "offset": -1,
      "expected_ids": ["rule_b", "rule_a", "default"]
    },
    {
      "name": "subscriptions use stable IDs",
      "collection": "subscriptions",
      "objects": [{ "id": "feed_a" }, { "id": "feed_b" }],
      "visible_ids": ["feed_a", "feed_b"],
      "move_id": "feed_b",
      "offset": -1,
      "expected_ids": ["feed_b", "feed_a"]
    }
  ]
}
